{
  "name": "dsh-agent-pyq",
  "version": "0.1.0",
  "description": "An AI moments (朋友圈) plugin for DeepSeek Harness: publish and view moments, with real-time projection updates and a styled browser UI.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./service": {
      "types": "./lib/service.d.ts",
      "default": "./lib/service.js"
    },
    "./hook": {
      "types": "./lib/hook.d.ts",
      "default": "./lib/hook.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/service.js",
    "lib/hook.js",
    "lib/client.js",
    "lib/index.d.ts",
    "lib/service.d.ts",
    "lib/hook.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf lib",
    "smoke": "node test/smoke.mjs",
    "test": "pnpm build && node test/smoke.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "template"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
